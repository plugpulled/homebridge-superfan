{
  "name": "homebridge-superfan",
  "displayName": "Homebridge Superfan",
  "version": "0.1.2",
  "description": "Control Superfan smart fans from Apple Home over your local network (unofficial).",
  "author": "Hanif Roshan",
  "license": "MIT",
  "homepage": "https://github.com/plugpulled/homebridge-superfan#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/plugpulled/homebridge-superfan.git"
  },
  "bugs": {
    "url": "https://github.com/plugpulled/homebridge-superfan/issues"
  },
  "keywords": [
    "homebridge-plugin",
    "supports-hap",
    "superfan",
    "kiot",
    "fan"
  ],
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "dist",
    "config.schema.json",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || ^26.0.0",
    "homebridge": "^1.8.0 || ^2.0.0"
  },
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "test": "vitest run",
    "prepublishOnly": "pnpm lint && pnpm test && pnpm build"
  },
  "dependencies": {
    "bonjour-service": "^1.4.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@homebridge/hap-nodejs": "2.3.0",
    "@types/node": "^22.20.5",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "homebridge": "2.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
